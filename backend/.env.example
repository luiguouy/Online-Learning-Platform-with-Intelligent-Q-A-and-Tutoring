# ============================================================
# SmartQA 本地开发环境变量模板
# 使用方法: 复制本文件为 backend/.env ，填入你自己的真实 Key
# (.env 已被 .gitignore 忽略，模板本身不含真实密钥，可安全提交)
# ============================================================

# ---- 对话大模型 (任意 OpenAI 兼容端点: OpenRouter / DeepSeek / 通义百炼) ----
# base-url 填到 /v1 为止，不要带 /chat/completions
# 注意 OpenRouter 的主机名：官方端点是**不带 api 前缀**的 `openrouter.ai`。
# 旧模板写的 `api.openrouter.ai` 本来就是不存在的域名（实测 NXDOMAIN）；在 Clash fake-ip 下
# 它表现为「CONNECT 建立后握手失败」的链路错误，很容易被误判成网络/代理问题，别照旧值抄。
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-YOUR_KEY_HERE
# 免费档模型的可用性波动很大（换版本、限流、503 都常见），填之前先自测一次再固定下来。
# 当前维护者本机实测可用的值为下面这一个；不是自己测过的值不要写进团队默认配置。
AI_CHAT_MODEL=nvidia/nemotron-3.5-super-vl:free

# ---- 代理 (可选; Java 不读系统代理，访问境外端点时才需要) ----
# 形如 http://127.0.0.1:7890（Clash 默认混合端口）；也接受省略 scheme 的 127.0.0.1:7890
# 或 socks5://host:port（按 SOCKS 走）。留空 = 直连。
# 启动时探测一次该端口：不可达、配置格式非法、缺主机名，三种情况都只打 WARN 并降级直连，
# 不会让应用启动失败，也不会让每次提问都失败成 5001。
# 但探测只证明「端口在监听」，不证明「代理能出网」：Clash 走直连/规则模式时端口可达，
# 境外请求照样失败，此时日志里有「走代理」也不代表链路是通的。
# 中途才启动代理客户端需要重启后端（探测只在启动时做一次）。
# AI_PROXY=http://127.0.0.1:7890

# ---- 向量库 (可选; 不启动 Chroma 时应用自动降级内存存储) ----
# CHROMA_HOST=localhost

# ---- MySQL (可选; 成员 B 联调时再填) ----
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DB=smart_qa
# MYSQL_USER=root
# MYSQL_PASSWORD=

# ============================================================
# 生产 / 公网部署（不要照搬本模板的本地默认值）
#
# 启动方式：--spring.profiles.active=prod（或 SPRING_PROFILES_ACTIVE=prod）
# prod profile（application-prod.yml）刻意不给下面这些项兜底，漏一个就启动失败：
#   MYSQL_PASSWORD         必填（本地/CI 才会用 application.yml 里的 123456）
#   MYSQL_HOST / MYSQL_PORT 必填
#   CORS_ALLOWED_ORIGINS   真实前端域名，逗号分隔，如 https://smartqa.example.com
# 接口文档在 prod 下已关闭（springdoc / knife4j），不要再手动设 SWAGGER_ENABLED=true；
# 反向代理（nginx）之后无需额外配置，prod 已设 server.forward-headers-strategy=native，
# 限流才能拿到真实客户端 IP（否则会把代理机当成所有用户的共同 IP）。
# ============================================================
