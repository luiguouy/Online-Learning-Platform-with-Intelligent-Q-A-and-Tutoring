# 本地私有开发环境配置模板
# 复制本文件为 application-local.yml 并填入您的真实密钥与数据库密码
# ⚠️ 注意：application-local.yml 已被 .gitignore 忽略，绝对不要提交到 Git！

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/smart_qa?useUnicode=true&characterEncoding=utf8mb4&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_LOCAL_MYSQL_PASSWORD

# 本地开发专用：MyBatis SQL 直接打印到控制台（仅 local profile 生效）
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

rag:
  llm:
    # 示例 1：使用 DeepSeek 官方 API
    base-url: https://api.deepseek.com/v1
    api-key: YOUR_DEEPSEEK_API_KEY
    chat-model: deepseek-chat
    # 示例 2：若使用阿里云百炼，将 base-url 改为 https://dashscope.aliyuncs.com/compatible-mode/v1，chat-model 改为 qwen-plus
  chroma:
    base-url: http://localhost:8000
